# Copie para .env (na raiz ou em server/) e ajuste.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clockfy
JWT_SECRET=troque-esta-chave
JWT_EXPIRES_IN=30d
APP_URL=http://localhost:3000

# E-mail (opcional – sem SMTP os e-mails são apenas logados no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Clockfy <no-reply@clockfy.local>"

# Segurança: contas criadas pela página "Criar conta" ficam aguardando aprovação de um administrador do sistema
# (Administração › Contas de usuário). A primeira conta da instalação é aprovada automaticamente e vira administradora.
REGISTRATION_APPROVAL=true
SIGNUP_LIMIT_PER_HOUR=10

# Limites e jobs
RATE_LIMIT_PER_SECOND=50
SCHEDULER_ENABLED=true
WEBHOOK_TIMEOUT_MS=10000
MAX_UPLOAD_BYTES=10485760
LOG_SQL=false
